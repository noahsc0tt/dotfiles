{
    "$schema": "https://opencode.ai/config.json",
    "update": "auto",
    "default_agent": "plan",
    "model": {
        "providerID": "github-copilot",
        "model": "auto"
    },
    "instructions": [
        "When writing or modifying code, do not add unnecessary comments. Avoid comments that merely restate what the code does, add filler phrases, or inject personality. Comments should only be used when they provide genuine value: explaining non-obvious intent, documenting complex business logic, or clarifying unavoidable workarounds.",
        "~/.agents/skills/caveman/SKILL.md"
    ],
    "agents": {
        "title": {
            "model": {
                "providerID": "opencode",
                "model": "nemotron-3-ultra-free"
            }
        },
        "build": {
            "permissions": [
                {
                    "action": "edit",
                    "resource": "*",
                    "effect": "ask"
                },
                {
                    "action": "apply_patch",
                    "resource": "*",
                    "effect": "ask"
                },
                {
                    "action": "read",
                    "resource": "*",
                    "effect": "allow"
                },
                {
                    "action": "edit",
                    "resource": "*",
                    "effect": "ask"
                },
                {
                    "action": "execute",
                    "resource": "*",
                    "effect": "ask"
                },
                {
                    "action": "delete",
                    "resource": "*",
                    "effect": "ask"
                },
                {
                    "action": "list",
                    "resource": "*",
                    "effect": "allow"
                },
                {
                    "action": "shell",
                    "resource": "*",
                    "effect": "ask"
                },
                {
                    "action": "shell",
                    "resource": "git status",
                    "effect": "allow"
                },
                {
                    "action": "shell",
                    "resource": "git diff",
                    "effect": "allow"
                },
                {
                    "action": "shell",
                    "resource": "git log",
                    "effect": "allow"
                },
                {
                    "action": "shell",
                    "resource": "ls",
                    "effect": "allow"
                },
                {
                    "action": "shell",
                    "resource": "pwd",
                    "effect": "allow"
                },
                {
                    "action": "shell",
                    "resource": "grep",
                    "effect": "allow"
                },
                {
                    "action": "shell",
                    "resource": "cd",
                    "effect": "allow"
                },
                {
                    "action": "webfetch",
                    "resource": "*",
                    "effect": "ask"
                }
            ]
        }
    },
    "plugins": [
        "@opeoginni/opencode-copilot-auto@1.1.0"
    ]
}
