(defsrc
  esc    f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  nubs   1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab    q    w    e    r    t    y    u    i    o    p    [    ]
  caps   a    s    d    f    g    h    j    k    l    ;    '    \   ret
  lsft   `   z    x    c    v    b    n    m    ,    .    /    up   rsft
  fn   lctl  lalt lmet           spc             rmet ralt left    down    right
)

;; _    _   _   _   _   _   _   _   _   _   _  _  _
;; _   _    _    _    _    _    _    _    _    _    _    _    _    _
;; _    _    _    _    _    _    _    _    _    _    _    _    _
;; _   _    _    _    _    _    _    _    _    _    _    _    _   _
;; _   _   _    _    _    _    _    _    _    _    _    _    _   _
;; _   _  _ _           _             _ _ _    _    _

(defcfg
 process-unmapped-keys yes
 log-layer-changes yes
 danger-enable-cmd yes
 concurrent-tap-hold yes
)

(defvar
 tap-time 1000
 hold-time 200
 chord-time 60
)

(defalias
    quote (multi lsft ')
    colon (multi lsft ;)
    pipe (multi lsft \)
    tilde (multi lsft `)
    question (multi lsft /)

    obrack (multi lsft 9)
    cbrack (multi lsft 0)
    ocurl (multi lsft [)
    ccurl (multi lsft ])

    exclam (multi lsft 1)
    at (multi lsft 2)
    hash (multi lsft 3)
    dollar (multi lsft 4)
    percent (multi lsft 5)
    caret (multi lsft 6)
    ampersand (multi lsft 7)
    asterisk (multi lsft 8)
    under (multi lsft -)
    less (multi lsft ,)
    greater (multi lsft .)
)

(defalias
    mback (multi lalt left)
    mword (multi lalt right)
    mftab (multi lctl tab)
    mbtab (multi lctl lsft tab)
)

(defalias
    qute (cmd open -a "qutebrowser")
    notebook (cmd open -a "NotebookLM")
    marta (cmd open -a "Marta")
    iterm (cmd open -a "iTerm")
    ghostty (cmd open -a "Ghostty")
    act-mon (cmd open -a "Activity Monitor")
    craft (cmd open -a "Craft")
    chatgpt (cmd open -a "ChatGPT")
    finder (cmd open -a "Finder")
    lastpass (cmd open -a "LastPass")
    mail (cmd open -a "Mail")
    outlook (cmd open -a "Microsoft Outlook")
    music (cmd open -a "Pear Desktop")
    youtube (cmd /Users/nscott/dev/scripts/youtube.sh)
    eqmac (cmd open -a "eqMac")
    tor (cmd open -a "Tor Browser")
    vivaldi (cmd open -a "Vivaldi")
    settings (cmd open -a "Settings")
    sioyek (cmd open -a "sioyek")
    nvim (multi lctl lmet lsft `)
    yazi (cmd open -a "Yazi")
    word (cmd open -a "Microsoft Word")
    plaintext (cmd open -a "Plain Text Editor")
    timetable (cmd open -a "UCL Timetable")
    min (cmd open -a "Min")
    intellij (cmd open -a "IntelliJ IDEA Community Edition")
)


(defalias
    hypmod (multi lctl lalt lmet lsft)
    launchmod (multi lctl lmet lsft)
    winmod (multi lalt lmet lsft)

    launch (tap-hold-press $tap-time $hold-time C-c @launchmod)
    shift (tap-hold-press $tap-time 250 bspc lsft)
    shift2 (tap-hold-press $tap-time 250 _ lsft)
    ctrl (tap-hold-press $tap-time $hold-time lsft lctl)
    cmd (tap-hold-press $tap-time $hold-time del lmet)

    srcly (tap-hold-press $tap-time $hold-time lrld (layer-toggle src))
    win (tap-hold-press $tap-time $hold-time _ @winmod)
    win-nav (tap-hold-press $tap-time $hold-time bspc (multi @winmod (layer-toggle window)))
    media-nav (tap-hold-press $tap-time $hold-time _ (layer-toggle media))
    navly (tap-hold-press $tap-time $hold-time tab (layer-toggle nav))
    apply (tap-hold-press $tap-time $hold-time (multi @launchmod nubs) (layer-toggle app))
    symly (tap-hold-press $tap-time $hold-time esc (layer-toggle sym))
    medialy (tap-hold-press $tap-time $hold-time caps (layer-toggle media))
    numly (tap-hold-press $tap-time $hold-time ret (layer-toggle num))
)



(deflayer base
  esc    brdn   brup   _   _   _   _   prev   pp   next   mute  vold  volu
  (layer-switch src)   1    2    3    4    5    6    7    8    9    0    -    =    bspc
    @navly    q    w    e    r    t    y    u    i    o    p    @launch caps
    @ctrl   a    s    d    f    g    h    j    k    l    @shift    @apply    \ ret
    @srcly   @cmd    z    x    c    v    b    n    m    ,    .    /    up   rsft
    fn     @shift2  rmet    @symly        spc             @numly ralt left    down    right
)

(deflayer src
esc    brdn   brup   bldn    brdn  _   _   prev   pp   next   mute  vold  volu
 (layer-switch base)  1    2    3    4    5    6    7    8    9    0    -    =    bspc
 tab q    w    e    r    t    y    u    i    o    p    [    ]
 caps   a    s    d    f    g    h    j    k    l    ;    '    \   ret
 lsft   `   z    x    c    v    b    n    m    ,    .    /    up   rsft
 fn   lctl  lalt lmet           spc             rmet ralt left    down    right
 )

(deflayer sym
 _    _   _   _   _   _   _   _   _   _   _  _  _
 _   _    _    _    _    _    _    _    _    _    _    _    _    _
 _    S-1    S-2    S-3    S-4    S-5    S-6    S-7    S-8    S-/    S-p    \    _
 _   S-;    -    S-[    S-9    S--    =    S-0    S-]    S-=    ;    _    _   _
 _   `   S-`    nubs    S-'    [    S-\    ]    '    S-,    S-.    _    _   _
 _   _  _ _           _             _ _ _    _    _
 )

(deflayer app
  _    _   _   _   _   _   _   _   _   _   _  _  _
  _   _    _    _    _    _    _    _    _    _    _    _    _    _
  (multi @winmod tab)    (multi lmet q)    (multi lmet w)    @mail    @finder    @tor    @youtube    @timetable    @iterm    @outlook    @min    _    _
  _   @act-mon    @settings    @sioyek    @ghostty   @chatgpt    (multi lmet h)     @qute  @music      @lastpass    @shift    @apply    \ ret  
  _     _   _   @plaintext    @craft    @vivaldi    @notebook    @nvim    @marta    @settings    .    /    up   rsft
  _   _  _ @win-nav           (multi @launchmod spc)         @eqmac _ _    _    _
)

(deflayermap window
    h h
    j j
    k k
    l l
    f f
    d d
    u u
    i i
    o o
    n n
    m m
    ; ;
    , ,
    . .
)

(defalias
    mallttab (multi @winmod [)
    malttab (multi @winmod ])
)

(deflayermap nav
    h left
    j down
    k up
    l right

    w @mword
    b @mback
    p @mbtab
    n @mftab

    f @malttab
    d @mallttab

    ; @media-nav
)

(deflayermap media
  f brdn
  j brup
  g bldn
  h blup
  ; (layer-toggle fine)
  d vold
  k volu
  s prev
  l next
  spc pp
)
(deflayermap fine
  f A-S-brdn
  j A-S-brup
  d A-S-vold
  k A-S-volu
)

(deflayermap fn
  a f1
  s f2
  d f3
  f f4
  g f5
  h f6
  j f7
  k f8
  l f9
  ; f10
  ' f11
  caps f12
)


(deflayermap num
  a 1
  s 2
  d 3
  f 4
  g 5
  h 6
  j 7
  k 8
  l 9
  ; 0
  lmet _
)


(defchordsv2
  (lmet rmet) lalt $chord-time all-released ()
)
