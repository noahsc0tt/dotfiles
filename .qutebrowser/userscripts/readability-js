const scriptsDir = path.join(process.env.QUTE_DATA_DIR, "userscripts")
const tmpFile = path.join(scriptsDir, "/readability.html")
const domOpts = {
    url: process.env.QUTE_URL,
    contentType: "text/html; charset=utf-8",
}

if (!fs.existsSync(scriptsDir)) {
    fs.mkdirSync(scriptsDir)
}

async function downloadAndEmbedImages(content, baseUrl) {
    const imgRegex = /<img[^>]+src="([^"]+)"[^>]*>/gi
    let match
    const imagePromises = []
    const imageReplacements = new Map()

    while ((match = imgRegex.exec(content)) !== null) {
        const [fullMatch, src] = match

        if (src.startsWith("data:") || imageReplacements.has(src)) {
            continue
        }

        let absoluteUrl
        try {
            if (src.startsWith("http://") || src.startsWith("https://")) {
                absoluteUrl = src
            } else {
                absoluteUrl = new URL(src, baseUrl).href
            }
        } catch (e) {
            continue
        }

        const promise = new Promise((resolve) => {
            const client = absoluteUrl.startsWith("https:") ? https : http
            const req = client.get(absoluteUrl, { timeout: 5000 }, (res) => {
                if (res.statusCode !== 200) {
                    resolve()
                    return
                }

                const chunks = []
                res.on("data", (chunk) => chunks.push(chunk))
                res.on("end", () => {
                    const buffer = Buffer.concat(chunks)
                    const contentType =
                        res.headers["content-type"] || "image/jpeg"
                    const base64 = buffer.toString("base64")
                    const dataUrl = `data:${contentType};base64,${base64}`
                    imageReplacements.set(src, dataUrl)
                    resolve()
                })
            })
            req.on("error", () => resolve())
            req.on("timeout", () => {
                req.destroy()
                resolve()
            })
        })

        imagePromises.push(promise)
    }

    await Promise.all(imagePromises)

    // Replace all image URLs with data URLs
    for (const [originalSrc, dataUrl] of imageReplacements) {
        content = content.replace(
            new RegExp(
                `src="${originalSrc.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")}"`,
                "g"
            ),
            `src="${dataUrl}"`
        )
    }

    return content
}

JSDOM.fromFile(process.env.QUTE_HTML, domOpts).then(async (dom) => {
    let reader = new Readability(dom.window.document)
    let article = reader.parse()

    // Download and embed images
    article.content = await downloadAndEmbedImages(
        article.content,
        process.env.QUTE_URL
    )

    let content =
        util.format(HEADER, article.title) +
        '<div class="container">' +
        article.content +
        "</div>"

    fs.writeFile(tmpFile, content, (err) => {
        if (err) {
            qute.messageError([`"${err}"`])
            return 1
        }
        // Success
        qute.open(["-t", tmpFile])

    })
